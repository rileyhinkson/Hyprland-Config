// Compact fastfetch layout for half-screen or quarter-screen terminals.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Fedora_small",
    "padding": { "top": 1, "left": 1, "right": 2 }
  },
  "display": {
    "separator": " ",
    "key": { "width": 7 },
    "size": { "binaryPrefix": "jedec", "ndigits": 1 }
  },
  "modules": [
    "title",
    { "type": "os",       "key": "os",   "format": "{name} {version-id}" },
    { "type": "kernel",   "key": "krnl", "format": "{release}" },
    { "type": "uptime",   "key": "up" },
    { "type": "packages", "key": "pkgs", "format": "{all}" },
    { "type": "shell",    "key": "sh",   "format": "{pretty-name}" },
    { "type": "de",       "key": "de",   "format": "{pretty-name}" },
    { "type": "cpu",      "key": "cpu",  "format": "{name}" },
    { "type": "memory",   "key": "mem",  "format": "{used} / {total}" },
    { "type": "disk",     "key": "disk", "folders": "/", "format": "{size-used} / {size-total}" },
    "colors"
  ]
}
