* {
    font: "JetBrainsMono Nerd Font 11";
    bg: #161616fa;
    bg-alt: #2a2a2a;
    fg: #e6e6e6;
    dim: #8a8a8a;
    accent: #33ccff;
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 460px;
    location: south east;
    anchor: south east;
    x-offset: -12px;
    y-offset: -46px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
}
mainbox { padding: 10px; spacing: 8px; children: [ inputbar, message, listview ]; }
inputbar { padding: 8px 10px; background-color: @bg-alt; border-radius: 8px; children: [ prompt, entry ]; spacing: 8px; }
prompt { text-color: @accent; }
entry { placeholder: "Search"; placeholder-color: @dim; }
message { padding: 6px 10px; background-color: @bg-alt; border-radius: 8px; }
textbox { text-color: @dim; }
listview { lines: 10; scrollbar: false; spacing: 2px; fixed-height: false; }
element { padding: 7px 10px; border-radius: 8px; }
element selected { background-color: @accent; text-color: #101010; }
element-text { text-color: inherit; }
